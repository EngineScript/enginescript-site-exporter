<?xml version="1.0" encoding="UTF-8"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    phpVersion="8.3"
    allFunctionsGlobal="true"
    allConstantsGlobal="true"
    findUnusedCode="true"
>
    <projectFiles>
        <file name="enginescript-site-exporter.php" />
        <directory name="includes" />
    </projectFiles>

    <stubs>
        <file name="vendor/php-stubs/wordpress-stubs/wordpress-stubs.php" />
        <file name="stubs/psalm-wordpress-constants.php" />
    </stubs>

    <issueHandlers>
        <!-- Psalm 7 rejects some docblocks in the WordPress stubs (php-stubs/wordpress-stubs).
             That file only describes WordPress to the analysers; this plugin's own code is
             still checked for every docblock. -->
        <InvalidDocblock>
            <errorLevel type="suppress">
                <file name="vendor/php-stubs/wordpress-stubs/wordpress-stubs.php" />
            </errorLevel>
        </InvalidDocblock>
    </issueHandlers>
</psalm>
