{
  "name": "enginescript/enginescript-site-exporter",
  "description": "EngineScript Site Exporter - Export your entire WordPress site as a ZIP archive",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "EngineScript",
      "email": "support@enginescript.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.5 || ^13.4",
    "squizlabs/php_codesniffer": "^3.13.6",
    "wp-coding-standards/wpcs": "^3.4.1",
    "phpcsstandards/phpcsutils": "^1.2.3",
    "phpcsstandards/phpcsextra": "^1.5",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpmd/phpmd": "^3.0",
    "vimeo/psalm": "^6.16",
    "php-stubs/wordpress-stubs": "^7.1.2",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "phpstan/phpstan": "^2.3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "automattic/vipwpcs": "^3.0.1",
    "z4kn4fein/php-semver": "^3.0",
    "rector/rector": "^2.6"
  },
  "scripts": {
    "phpcs": "phpcs --standard=phpcs.xml",
    "phpcs:fix": "phpcbf --standard=phpcs.xml",
    "phpmd": "phpmd analyze . --no-progress --format text --ruleset phpmd.xml --exclude vendor --exclude tests --exclude node_modules --exclude .private",
    "psalm": "psalm --config=psalm.xml --show-info=true",
    "psalm:taint": "psalm --config=psalm.xml --taint-analysis",
    "phpstan": "phpstan analyze --memory-limit=1G",
    "rector": "rector process --dry-run --no-progress-bar",
    "test": "phpunit --configuration phpunit.xml --testsuite unit --fail-on-empty-test-suite",
    "make-pot": [
      "wp i18n make-pot . languages/enginescript-site-exporter.pot --slug=enginescript-site-exporter --domain=enginescript-site-exporter --include=enginescript-site-exporter.php,includes,js --headers={\\\"Report-Msgid-Bugs-To\\\":\\\"https://github.com/EngineScript/enginescript-site-exporter/issues\\\"}",
      "git diff --quiet --ignore-matching-lines=POT-Creation-Date: -- languages/enginescript-site-exporter.pot && git checkout -- languages/enginescript-site-exporter.pot || exit 0"
    ],
    "check-all": [
      "@phpcs",
      "@phpmd",
      "@psalm",
      "@psalm:taint",
      "@phpstan",
      "@rector",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.3.16"
    }
  }
}
