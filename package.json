{
  "name": "enginescript-site-exporter",
  "private": true,
  "description": "Development tooling for EngineScript Site Exporter: tests for the admin script, and the JavaScript, Markdown and CSS linters.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:js": "eslint --max-warnings 0 .",
    "lint:md": "markdownlint-cli2",
    "test": "node --test \"tests/js/**/*.test.mjs\""
  },
  "devDependencies": {
    "@wordpress/browserslist-config": "6.57.0",
    "@wordpress/eslint-plugin": "27.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "markdownlint-cli2": "0.23.3",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-no-unsupported-browser-features": "8.1.2"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "overrides": {
    "smol-toml": "1.9.1",
    "katex": "0.19.0"
  }
}
