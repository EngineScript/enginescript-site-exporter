{
  "name": "enginescript-site-exporter",
  "private": true,
  "description": "Development tooling for EngineScript Site Exporter: tests for the admin script, and the JavaScript, Markdown and CSS linters.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "lint:css": "stylelint --config stylelint-wordpress.json \"css/**/*.css\"",
    "lint:biome": "biome lint .",
    "lint:js": "eslint --config eslint.wordpress.config.mjs --max-warnings 0 .",
    "lint:md": "markdownlint-cli2",
    "test": "node --test \"tests/js/**/*.test.mjs\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@wordpress/browserslist-config": "7.2.0",
    "@wordpress/eslint-plugin": "28.2.0",
    "@wordpress/stylelint-config": "27.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "markdownlint-cli2": "0.24.2",
    "stylelint": "17.16.0",
    "stylelint-no-unsupported-browser-features": "8.1.2",
    "stylelint-scss": "7.5.0"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "overrides": {
    "smol-toml": "1.9.1",
    "katex": "0.19.0",
    "re2js": "2.8.7"
  }
}
